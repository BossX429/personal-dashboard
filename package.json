{
  "name": "personal-dashboard",
  "version": "1.0.0",
  "description": "A modern personal dashboard with Azure integration",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run build:client",
    "build:client": "webpack --mode production",
    "test": "jest",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "^17.9.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.3.1"
  },
  "keywords": [
    "dashboard",
    "azure",
    "monitoring",
    "personal"
  ],
  "author": "BossX429",
  "license": "MIT",
  "controllers": {
    "UserController": {
      "path": "/api/users",
      "methods": {
        "getCurrentUser": {
          "httpMethod": "GET",
          "endpoint": "/profile",
          "description": "Secure user profile management"
        }
      }
    }
  },
  "services": {
    "AnalyticsService": {
      "metricsRepository": "MetricsRepository",
      "methods": {
        "getSystemMetrics": {
          "description": "High-performance data processing"
        }
      }
    }
  },
  "jobs": {
    "SystemMonitorJob": {
      "schedule": "fixedRate",
      "interval": 30000,
      "description": "Scheduled system monitoring"
    }
  },
  "overrides": {
    "js-yaml": "^3.15.2"
  }
}
